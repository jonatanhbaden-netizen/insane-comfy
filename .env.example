# Copy the values you need into the RunPod template's Environment Variables.
# (RunPod has no .env file support — this file documents the variables.)

# HuggingFace token. Only needed for the gated flux1-redux-dev style model;
# every other model in download_models.sh is ungated.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# First boot: true (fetches ~95 GB to /workspace/models, 20-60 min).
# After the volume is populated: false for ~30 s boots.
DOWNLOAD_MODELS=true

# Also fetch the gated Redux style model (needs HF_TOKEN + accepting the
# license on the FLUX.1-Redux-dev HuggingFace page once).
WITH_REDUX=false

# Set to any value to start JupyterLab on :8888 with this token.
JUPYTER_PASSWORD=

# Override ComfyUI launch args entirely (default: --preview-method auto
# plus --use-sage-attention when available).
COMFY_ARGS=
